# ── Constructa editor: cloud project sync (Supabase) ─────────────────────────
# OPTIONAL. If these are unset the editor runs standalone (IndexedDB) exactly as
# before. Set them to enable dashboard-launched projects + cloud auto-save.
#
# Use the SAME Supabase project and publishable key as the landing/dashboard app.
# Publishable keys (sb_publishable_…) are public-safe and are baked into the
# static build — that is expected.
#
# Copy this file to `.env` (or `.env.production`) and fill in real values BEFORE
# `npm run build` / `npm run deploy` (Vite inlines VITE_* at build time).

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Where the in-editor "← Dashboard" button returns users (the landing app).
# Defaults to https://constructa-page.atumx.in/dashboard if unset.
VITE_DASHBOARD_URL=https://constructa-page.atumx.in/dashboard
